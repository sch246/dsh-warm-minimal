+    await first.loader.root.update([{ id: 'same-row', name: 'cordis:provenance-replacement' }])
+    await first.loader.await()
+    expect(sourceOf(await first.systemPrompt.assemble(), 'sections', 'owned')).toBe(firstSource)
+
