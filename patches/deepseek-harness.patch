+} from '@deepseek-ai/dsh-system-prompt'
+import type { AssembleContext, HostSourceId, PromptAssembly } from '@deepseek-ai/dsh-system-prompt'
+
+async function setup(): Promise<Context> {
+  const ctx = new Context()
+  await ctx.plugin(Loader)
+  await ctx.plugin(SystemPrompt, { includeHarnessIdentity: false })
+  return ctx
+}
+
+async function load(
+  ctx: Context,
+  builtin: string,
+  plugin: ((ctx: Context) => void) & { inject?: string[] },
+): Promise<HostSourceId> {
+  ctx.loader.builtins[builtin] = plugin
+  const id = await ctx.loader.create({ name: `cordis:${builtin}` })
+  await ctx.loader.await()
+  const fiber = ctx.loader.resolve(id).fiber
+  if (fiber === undefined) throw new Error(`test Loader entry ${id} has no active fiber`)
+  return hostSourceId(fiber.ctx)
+}
+
+function sourceOf(assembly: PromptAssembly, kind: 'sections' | 'contexts' | 'tools', name: string): string | undefined {
+  return promptAssemblySourceInventory(assembly)[kind].find(entry => entry.name === name)?.source
+}
+
+describe('prompt assembly host provenance', () => {
+  it('derives the same source before and after a Loader entry mounts', () => {
+    const entry = { id: 'nested:tool', parent: { tree: { filename: '/presets/warm-minimal.cordis.yml' } } }
+    const mounted = hostSourceId({
+      fiber: {
+        entry,
+        parent: { fiber: undefined },
+      },
+    } as unknown as Context)
+
+    expect(hostSourceIdForEntry(entry)).toBe(mounted)
+  })
+
+  it('separates file-backed trees while keeping each configured path stable', () => {
+    const source = (filename: string): HostSourceId => hostSourceId({
+      fiber: {
+        entry: { id: 'same-row', parent: { tree: { filename } } },
+        parent: { fiber: undefined },
+      },
+    } as unknown as Context)
+
+    expect(source('/presets/warm-minimal.cordis.yml')).toBe(source('/presets/warm-minimal.cordis.yml'))
+    expect(source('/presets/warm-minimal.cordis.yml')).not.toBe(source('/presets/other.cordis.yml'))
+    expect(source('/presets/warm-minimal.cordis.yml')).not.toContain('/presets/')
+  })
+
+  it('keeps the configured entry path stable across fiber and process replacement', async () => {
+    const first = await setup()
+    const section = (text: string) => Object.assign((inner: Context) => {
+      inner.systemPrompt.section({ name: 'owned', order: 1, text })
+    }, { inject: ['systemPrompt'] })
+    first.loader.builtins['provenance-first'] = section('first')
+    await first.loader.root.update([{ id: 'same-row', name: 'cordis:provenance-first' }])
+    await first.loader.await()
