+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import Loader from '@deepseek-ai/cordis-plugin-loader'
+import { createScope } from '@deepseek-ai/dsh-scope'
+import SystemPrompt, { hostSourceId, promptAssemblySourceInventory } from '@deepseek-ai/dsh-system-prompt'
+import type { HostSourceId } from '@deepseek-ai/dsh-system-prompt'
+import ToolRuntime, { defineTool } from '@deepseek-ai/dsh-tools'
+
+// @meta-intent:begin dsh-warm-minimal (purpose: prove tool schemas retain each winning tool registration's source)
+function tool(name: string, description: string) {
+  return defineTool({
+    name,
+    description,
+    parameters: {},
+    output: { schema: { type: 'string' }, render: (_args, value) => [{ type: 'text', text: value }] },
+    execute: () => Promise.resolve(description),
+  })
+}
+
+async function load(ctx: Context, builtin: string, plugin: ((ctx: Context) => void) & { inject?: string[] }): Promise<HostSourceId> {
+  ctx.loader.builtins[builtin] = plugin
+  const id = await ctx.loader.create({ name: `cordis:${builtin}` })
+  await ctx.loader.await()
+  const fiber = ctx.loader.resolve(id).fiber
+  if (fiber === undefined) throw new Error(`test Loader entry ${id} has no active fiber`)
+  return hostSourceId(fiber.ctx)
+}
+
+describe('tool registration host provenance', () => {
+  it('projects per-tool sources for multiple registrations and a scoped shadow', async () => {
+    const ctx = new Context()
+    await ctx.plugin(Loader)
+    await ctx.plugin(SystemPrompt, { includeHarnessIdentity: false })
+    await ctx.plugin(ToolRuntime)
+    const key = {}
+    const global = Object.assign((inner: Context) => {
+      inner.tools.register(tool('shared', 'global'))
+      inner.tools.register(tool('global-only', 'global'))
+    }, { inject: ['tools'] })
+    const globalSource = await load(ctx, 'tool-source-global', global)
+    const scoped = Object.assign((inner: Context) => {
+      const scope = createScope(inner, key)
+      scope.ctx.tools.register(tool('shared', 'scoped'))
+      scope.ctx.tools.register(tool('scoped-only', 'scoped'))
+    }, { inject: ['tools', 'systemPrompt'] })
+    const scopedSource = await load(ctx, 'tool-source-scoped', scoped)
+
+    const globalInventory = promptAssemblySourceInventory(await ctx.systemPrompt.assemble()).tools
+    expect(globalInventory).toEqual([
+      { name: 'global-only', source: globalSource },
+      { name: 'shared', source: globalSource },
+    ])
+    const scopedInventory = promptAssemblySourceInventory(await ctx.systemPrompt.assemble({ scope: key })).tools
+    expect(scopedInventory).toEqual([
+      { name: 'global-only', source: globalSource },
+      { name: 'scoped-only', source: scopedSource },
+      { name: 'shared', source: scopedSource },
+    ])
+  })
+})
+// @meta-intent:end dsh-warm-minimal
