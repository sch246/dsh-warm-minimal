{
  "name": "dsh-warm-minimal",
  "version": "0.2.0",
  "description": "DSH warm-minimal mode with an optional minimal bootstrap and configurable coordinator/worker model visibility.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./config": "./config.mjs",
    "./projection": "./projection-host.mjs",
    "./runtime": "./runtime.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    ".intent",
    "AGENTS.md",
    "index.mjs",
    "config.mjs",
    "host.mjs",
    "projection.mjs",
    "projection-host.mjs",
    "runtime.mjs",
    "cordis.patch.yml",
    "presets",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "uninstall": "bash scripts/uninstall.sh",
    "uninstall:win": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "warm-start",
    "minimal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sch246/dsh-warm-minimal.git"
  },
  "bugs": {
    "url": "https://github.com/sch246/dsh-warm-minimal/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
