{
  "name": "dsh-warm-minimal-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/workspace.mjs build",
    "typecheck": "node scripts/workspace.mjs typecheck",
    "setup": "node scripts/workspace.mjs setup",
    "inspect": "node scripts/workspace.mjs inspect",
    "remove": "node scripts/workspace.mjs remove",
    "test": "node --test tests/*.test.mjs packages/dsh-warm-minimal/tests/*.test.mjs packages/dsh-warm-minimal/tests/client/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.22.14"
  }
}
